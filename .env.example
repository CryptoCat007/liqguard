# LiqGuard configuration
# Copy this file to .env and fill in your values. Never commit .env.

# Required for the bot: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Meta AI API key (leave empty to run Muse in deterministic mock mode)
META_API_KEY=
# META_MODEL=muse-spark

# --------------------------------------------------------------------------
# Master key (envelope encryption)
# --------------------------------------------------------------------------
# The master key wraps a per-user data key; each user's exchange credentials
# are encrypted with their own data key. Generate one with:
#   python3 -c "from liqguard.storage import generate_key; print(generate_key())"
#
# Rotation: put the NEW key first, comma-separated with the old one(s), then
# run storage.rotate_master_key() once; afterwards the old key can be removed.
#
# If unset, LiqGuard loads (or creates, mode 600) the key file below. Back it
# up: losing the master key makes stored exchange keys unreadable.
LIQGUARD_MASTER_KEY=
# LIQGUARD_ENCRYPTION_KEY=          # legacy name, still accepted
# LIQGUARD_KEY_FILE=~/.liqguard/encryption.key

# Optional: database path and poll interval
LIQGUARD_DB_PATH=liqguard.db
LIQGUARD_POLL_INTERVAL=30

# --------------------------------------------------------------------------
# Web dashboard
# --------------------------------------------------------------------------
LIQGUARD_DASHBOARD=false
LIQGUARD_DASHBOARD_HOST=127.0.0.1
LIQGUARD_DASHBOARD_PORT=8765

# Public URL the bot puts in /dashboard login links (use https in production;
# session cookies are marked Secure when this starts with https://).
LIQGUARD_PUBLIC_URL=
# Bot username for the Telegram Login Widget (also auto-detected at startup).
# The widget additionally needs BotFather /setdomain for the dashboard domain.
LIQGUARD_BOT_USERNAME=

# Session signing secret (>= 32 chars). If unset, it is derived from the master key.
LIQGUARD_SESSION_SECRET=
# Session lifetime and one-time login link lifetime, in seconds.
LIQGUARD_SESSION_TTL=43200
LIQGUARD_LOGIN_LINK_TTL=300

# --------------------------------------------------------------------------
# Protective actions (tier 1, testnet only)
# --------------------------------------------------------------------------
# When true, users can confirm add-margin actions on positions from a bound
# Binance *testnet* key. Mainnet is never traded, regardless of this flag.
LIQGUARD_PROTECT_ENABLED=false

# --------------------------------------------------------------------------
# Funding, fees and the rescue simulator
# --------------------------------------------------------------------------
# Taker fee rates used in rescue costs (0.0005 = 0.05%). Set to your VIP tier.
LIQGUARD_TAKER_FEE_BINANCE=0.0005
LIQGUARD_TAKER_FEE_HYPERLIQUID=0.00045
# Seconds between funding-rate refreshes from the public Binance/Hyperliquid APIs.
LIQGUARD_FUNDING_REFRESH=60
# Warn this many minutes before a funding settlement when a near-liquidation
# position is about to pay a large funding payment.
LIQGUARD_PREFUNDING_LEAD_MINUTES=30

# --------------------------------------------------------------------------
# Wick stress test, adaptive tiers, stop-loss checks, wake-up escalation
# --------------------------------------------------------------------------
# Window and refresh for the public 1m/5m kline cache (rate limited per venue).
LIQGUARD_WICK_DAYS=30
LIQGUARD_WICK_REFRESH=3600
# Low-liquidity hours (UTC, start-end) when alert tiers widen ×1.10.
LIQGUARD_LOW_LIQUIDITY_HOURS_UTC=21-1
# Minimum gap between a stop and the liquidation price, in percent.
LIQGUARD_STOP_BUFFER_PCT=0.5
# Defaults for new users; each user can change them with /settings.
LIQGUARD_ESCALATION_INTERVAL_MINUTES=2
LIQGUARD_ESCALATION_MAX_REMINDERS=5
