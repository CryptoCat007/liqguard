# LiqGuard Configuration
# Copy this file to .env and fill in your values

# Required: Telegram Bot Token
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Meta AI API Key
# Enables AI risk explanations, screenshot parsing, and /ask command
# Get from https://api.meta.ai — leave empty to run Muse in deterministic mock mode
META_API_KEY=

# Recommended: Encryption Key for storing API secrets
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or use the helper:
#   python -c "from liqguard.services import EncryptedStorage; print(EncryptedStorage.generate_key())"
#
# If not set, LiqGuard will automatically generate a key and save it to
# ~/.liqguard/encryption.key (with a warning). This is fine for development,
# but for production you should set this explicitly and back up the key.
#
# WARNING: If you lose this key, all stored API secrets become unreadable
# and you'll need to re-bind your exchange accounts.
LIQGUARD_ENCRYPTION_KEY=

# Optional: Database path
# Default: liqguard.db in current directory
LIQGUARD_DB_PATH=liqguard.db

# Optional: Position check interval in seconds
# Default: 30
LIQGUARD_POLL_INTERVAL=30

# Optional: Web dashboard (read-only, demo data)
# Enable alongside the bot (same as `liqguard --dashboard`)
LIQGUARD_DASHBOARD=false
LIQGUARD_DASHBOARD_HOST=127.0.0.1
LIQGUARD_DASHBOARD_PORT=8765

# Optional: Telegram chat IDs (comma-separated) that receive dashboard
# "Simulate market" alerts even before they run /demo. Find yours via @userinfobot.
LIQGUARD_DEMO_CHAT_IDS=
